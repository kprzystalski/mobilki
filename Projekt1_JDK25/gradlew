#!/bin/sh
# Dydaktyczny bootstrap Gradle Wrapper 9.6.1.
# Pobiera oficjalny plik wrapper JAR i sprawdza jego SHA-256 przed uruchomieniem.
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_DIR="$APP_HOME/gradle/wrapper"
WRAPPER_JAR="$WRAPPER_DIR/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Pierwsze uruchomienie: pobieranie Gradle Wrapper 9.6.1..."
    command -v curl >/dev/null 2>&1 || { echo 'Brak curl.' >&2; exit 1; }
    TMP_JAR="$WRAPPER_JAR.download"
    TMP_SHA="$WRAPPER_JAR.sha256.download"
    trap 'rm -f "$TMP_JAR" "$TMP_SHA"' EXIT INT TERM
    curl --fail --location --silent --show-error --retry 2 \
      'https://services.gradle.org/distributions/gradle-9.6.1-wrapper.jar' -o "$TMP_JAR"
    curl --fail --location --silent --show-error --retry 2 \
      'https://services.gradle.org/distributions/gradle-9.6.1-wrapper.jar.sha256' -o "$TMP_SHA"
    EXPECTED=$(tr -d '\r\n ' < "$TMP_SHA")
    if command -v shasum >/dev/null 2>&1; then
        ACTUAL=$(shasum -a 256 "$TMP_JAR" | cut -d ' ' -f 1)
    elif command -v sha256sum >/dev/null 2>&1; then
        ACTUAL=$(sha256sum "$TMP_JAR" | cut -d ' ' -f 1)
    else
        echo 'Brak narzędzia SHA-256 (shasum lub sha256sum).' >&2; exit 1
    fi
    [ "$ACTUAL" = "$EXPECTED" ] || { echo 'Błąd weryfikacji SHA-256 Gradle Wrapper!' >&2; exit 1; }
    mv "$TMP_JAR" "$WRAPPER_JAR"
    rm -f "$TMP_SHA"
    trap - EXIT INT TERM
fi

if [ -n "${JAVA_HOME:-}" ]; then
    JAVA_CMD="$JAVA_HOME/bin/java"
    [ -x "$JAVA_CMD" ] || { echo "Nieprawidłowe JAVA_HOME: $JAVA_HOME" >&2; exit 1; }
else
    JAVA_CMD=java
fi
exec "$JAVA_CMD" -cp "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
